<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class entity-name="ApiKey" lazy="false" name="org.kecak.apps.apiKeys.model.ApiKey" table="app_api_key">
		<id name="id" type="string">
			<generator class="uuid" />
		</id>
		<property name="dateCreated" type="timestamp" />
		<property name="dateModified" type="timestamp" />
		<property name="createdBy" type="string" />
		<property name="modifiedBy" type="string" />

		<property name="apiKey" type="string" length="512" column="api_key"/>
		<property name="impersonates" type="string" />
		<property name="remark" type="string" />
		<property name="validUntil" type="timestamp" column="valid_until"/>
		<property name="domainWhitelist" type="string" column="domain_whitelist"/>
		<property name="active" type="boolean" />
	</class>
</hibernate-mapping>
